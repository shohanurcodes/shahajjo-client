# BetterAuth session signing key (generate with: openssl rand -base64 48)
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# App origins
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=sahajjo

# Express API
NEXT_PUBLIC_API_URL=http://localhost:5000

# Social OAuth — GitHub (optional; create credentials at https://github.com/settings/developers)
# The button appears automatically when both values are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Social OAuth — Google (optional; create credentials at https://console.cloud.google.com/apis/credentials)
# The button appears automatically when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
